{
  "expo": {
    "name": "nummus",
    "slug": "nummus",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nummus",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.nummus.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {},
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0E17"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
